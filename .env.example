# Optional first-launch configuration for a new local data directory.
# Prefer the settings UI. Existing DPAPI credentials are not overwritten.
# Never commit your .env file or share API keys.
AEVORA_PROVIDER_DIALECT=openai-compatible
AEVORA_PROVIDER_BASE_URL=
AEVORA_PROVIDER_MODEL=
AEVORA_PROVIDER_API_KEY=

# Optional experimental web search; permission must be granted in the app.
AEVORA_TAVILY_API_KEY=

# Optional Beijing-region speech configuration; disabled until confirmed.
AEVORA_SPEECH_REGION=cn-beijing
AEVORA_SPEECH_WORKSPACE_ID=
AEVORA_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
AEVORA_ASR_API_KEY=
AEVORA_ASR_ENABLED=false
AEVORA_TTS_MODEL=qwen-audio-3.1-tts-flash
AEVORA_TTS_API_KEY=
AEVORA_TTS_VOICE=longanhuan_v3.1
AEVORA_TTS_ENABLED=false
# Set your own free-quota deadline. Blank prevents TTS authorization.
AEVORA_TTS_FREE_UNTIL=
