# Development-only import on the first debug desktop launch for a new data directory.
# Subsequent changes use the native Provider settings; credentials are DPAPI-backed.
AEVORA_PROVIDER_DIALECT=openai-compatible
AEVORA_PROVIDER_BASE_URL=
AEVORA_PROVIDER_MODEL=
AEVORA_PROVIDER_API_KEY=

# Tavily Search: paste your API key after '=' (no quotes needed).
# Development credential only; filling this does not authorize outbound calls.
AEVORA_TAVILY_API_KEY=

# R3 Host speech configuration: new debug data directories import once, disabled.
# The native Speech settings can explicitly import missing credentials, still disabled.
# Filling these fields does not authorize or trigger API calls.
# Use the Beijing-region Model Studio API key and matching Workspace ID.
# ASR and TTS may use the same authorized key; paste it into each field.
# Never paste keys into chat or commit .env.
AEVORA_SPEECH_REGION=cn-beijing
AEVORA_SPEECH_WORKSPACE_ID=
AEVORA_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
AEVORA_ASR_API_KEY=
AEVORA_ASR_ENABLED=false
AEVORA_TTS_MODEL=qwen-audio-3.1-tts-flash
AEVORA_TTS_API_KEY=
AEVORA_TTS_VOICE=longanhuan_v3.1
AEVORA_TTS_ENABLED=false
