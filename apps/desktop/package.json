{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron desktop shell for a bundled dsh runtime and external plugins",
  "version": "0.2.1-rc.3",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Hangzhou DeepSeek Artificial Intelligence Co., Ltd."
  },
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -b && pnpm run bundle",
    "bundle": "tsdown --config-loader native",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts --skip-build",
    "prepare:runtime": "tsx scripts/prepare-runtime.ts",
    "prepare:primary-runtime": "tsx scripts/prepare-primary-runtime.ts",
    "prepare:packages": "tsx scripts/prepare-package-set.ts",
    "prepare:dsh": "tsx scripts/prepare-dsh.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "ws": "^8.21.3",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-official-bundles": "workspace:*",
    "@deepseek-ai/node-addon-system": "workspace:~",
    "@electron/get": "^5.1.0",
    "@electron/notarize": "2.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "app-builder-lib": "26.17.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.3.2",
    "koffi": "3.1.1",
    "pnpm": "11.28.5",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-deepseek-account": "workspace:*",
    "@types/ws": "^8.18.1",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.4.3",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:*",
    "@deepseek-ai/dsh-client-shortcuts": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-client-product-analytics": "workspace:*",
    "@deepseek-ai/dsh-util-file-drag": "workspace:*"
  }
}
